<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="450.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gnaix.MainWindow">

    <children>

        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="50.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <content>
                <VBox fx:id="dialogContainer"
                      prefWidth="430.0"
                      spacing="5.0" />
            </content>

        </ScrollPane>

        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   promptText="Type a command..."
                   prefHeight="45.0"
                   AnchorPane.bottomAnchor="2.0"
                   AnchorPane.leftAnchor="2.0"
                   AnchorPane.rightAnchor="82.0" />

        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="45.0"
                prefWidth="78.0"
                text="Send"
                AnchorPane.bottomAnchor="2.0"
                AnchorPane.rightAnchor="2.0" />

    </children>
</AnchorPane>