<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="450.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gnaix.MainWindow">

    <children>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT"
              prefHeight="100.0"
              spacing="12.0"
              styleClass="header"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">

            <padding>
                <Insets bottom="10.0"
                        left="15.0"
                        right="15.0"
                        top="10.0" />
            </padding>

            <ImageView fx:id="headerImage"
                       fitHeight="48.0"
                       fitWidth="48.0"
                       preserveRatio="true" />

            <Label fx:id="headerBanner"
                   styleClass="header-banner" />

        </HBox>

        <!-- Conversation -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    AnchorPane.topAnchor="100.0"
                    AnchorPane.bottomAnchor="50.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <content>
                <VBox fx:id="dialogContainer"
                      prefWidth="430.0"
                      spacing="4.0">

                    <padding>
                        <Insets top="8.0"
                                right="8.0"
                                bottom="8.0"
                                left="8.0" />
                    </padding>

                </VBox>
            </content>

        </ScrollPane>

        <!-- Input -->
        <HBox alignment="CENTER"
              spacing="4.0"
              styleClass="input-area"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <padding>
                <Insets bottom="4.0"
                        left="4.0"
                        right="4.0"
                        top="4.0" />
            </padding>

            <TextField fx:id="userInput"
                       onAction="#handleUserInput"
                       promptText="Type a command..."
                       prefHeight="42.0"
                       HBox.hgrow="ALWAYS" />

            <Button fx:id="sendButton"
                    mnemonicParsing="false"
                    onAction="#handleUserInput"
                    prefHeight="42.0"
                    prefWidth="78.0"
                    text="Send" />

        </HBox>

    </children>

</AnchorPane>